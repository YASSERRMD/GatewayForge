FROM golang:1.25.5-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/control-plane ./cmd/control-plane
COPY internal/control ./internal/control
COPY internal/shared ./internal/shared
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/control-plane ./cmd/control-plane

FROM alpine:3.21
RUN apk add --no-cache wget ca-certificates && adduser -D -u 10001 appuser
COPY --from=builder /out/control-plane /usr/local/bin/control-plane
USER appuser
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/control-plane"]
