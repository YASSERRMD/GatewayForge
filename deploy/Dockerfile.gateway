FROM golang:1.25.5-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/gateway ./cmd/gateway
COPY internal/gateway ./internal/gateway
COPY internal/shared ./internal/shared
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/gateway ./cmd/gateway

FROM alpine:3.21
RUN apk add --no-cache wget ca-certificates && adduser -D -u 10001 appuser
COPY --from=builder /out/gateway /usr/local/bin/gateway
USER appuser
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/gateway"]
