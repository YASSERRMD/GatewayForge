# GatewayForge local development configuration (DUMMY VALUES ONLY — never use in production)
GATEWAYFORGE_ENV=development

# Host Port Bindings (all bound exclusively to 127.0.0.1 in docker-compose.yml)
CONTROL_PLANE_PORT=18080
GATEWAY_PORT=18081
GATEWAY_2_PORT=18082
MOCK_UPSTREAM_PORT=18089
MOCK_UPSTREAM_2_PORT=18090
WEB_PORT=3000
PROMETHEUS_PORT=19090
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=14318

# Control Plane
CONTROL_PLANE_ADDR=:8080
CONTROL_PLANE_SHUTDOWN_TIMEOUT_SEC=10
CONTROL_PLANE_CORS_ORIGINS=http://localhost:3000
SESSION_SECRET=dev-only-session-secret-change-me-32chars-minimum
GATEWAY_SYNC_TOKEN=dev-only-gateway-sync-token-123456
GATEWAY_PROXY_URL=http://127.0.0.1:18081

# Gateway Data Plane
GATEWAY_INSTANCE_ID=gateway-local-1
GATEWAY_ADDR=:8081
GATEWAY_SHUTDOWN_TIMEOUT_SEC=15
CONTROL_PLANE_URL=http://127.0.0.1:18080
GATEWAY_SYNC_INTERVAL_SEC=5

# Local mock upstream support (forbidden in production)
ALLOW_MOCK_UPSTREAMS=true

# Optional OpenTelemetry / Jaeger Tracing (enable with: docker compose --profile observability up -d)
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACE_VIEWER_BASE_URL=http://127.0.0.1:16686/trace/

# PostgreSQL (local Docker Compose)
POSTGRES_DB=gatewayforge
POSTGRES_USER=gatewayforge
POSTGRES_PASSWORD=gatewayforge_local_dev_pw
POSTGRES_PORT=5439
DATABASE_URL=postgres://gatewayforge:gatewayforge_local_dev_pw@127.0.0.1:5439/gatewayforge?sslmode=disable

# Redis (local Docker Compose)
REDIS_PORT=6389
REDIS_ADDR=127.0.0.1:6389
REDIS_PASSWORD=gatewayforge_local_redis_pw

# Next.js Dashboard
NEXT_PUBLIC_CONTROL_PLANE_URL=http://127.0.0.1:18080
CONTROL_PLANE_INTERNAL_URL=http://127.0.0.1:18080
